{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitr",
  "identifier": "dev.gitr.app",
  "build": {
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "pnpm --filter ui build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gitr",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "zoomHotkeysEnabled": false,
        "devtools": true,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Etienne de Lange",
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QkE3QTM4RDFGNTRBNkYKUldSdlN2WFJPSHE2OXRTbnpWKzF1S01FVWhPanpDVUxOV1A2amEwMzJwV2hkT3pZdjI1cjIwRWoK",
      "endpoints": [
        "https://github.com/etiennedelange/gitr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}